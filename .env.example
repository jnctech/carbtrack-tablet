# Where the client sends API requests. In dev this is "/api" so the Vite
# server can proxy to the real backend (avoiding CORS); in production set
# this to the same-origin path that your reverse proxy maps to carbtrack-au.
VITE_API_BASE_URL=/api

# Optional bearer token. Leave blank if the API is unauthenticated or
# fronted by a proxy that handles auth.
VITE_API_TOKEN=

# Dev-server only: when set, vite.config.ts forwards /api/* to this URL.
# Not bundled into the client. Leave blank in production.
VITE_DEV_API_PROXY_TARGET=https://carbtrack-au.colebungalow.com
